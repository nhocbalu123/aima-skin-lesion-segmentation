   "source": [
    "## 16. Generate and validate the submission\n",
    "\n",
    "This cell deliberately reconstructs every path it uses. It does not depend on the checkpoint-inspection cell having run."

   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "41d66c6b",
   "metadata": {},
   "outputs": [],
   "source": [
    "from pathlib import Path\n",
    "import json\n",
    "import subprocess\n",
    "import sys\n",
    "import pandas as pd\n",
    "\n",
    "# Reconstruct all submission state inside this cell.\n",
    "work_root = Path(\"/kaggle/working\")\n",
    "output_dir = work_root / \"artifacts\" / \"controlled_rerun\"\n",
    "config_path = work_root / \"kaggle_controlled_rerun.json\"\n",
    "checkpoint_path = output_dir / \"best_model.keras\"\n",
    "postprocessing_path = REPO_ROOT / \"results\" / \"controlled_rerun\" / \"final_submission_parameters.json\"\n",
    "submission_path = output_dir / \"submission.csv\"\n",
    "submission_summary_path = output_dir / \"submission_validation_summary.json\"\n",
    "\n",
    "if RUN_SUBMISSION:\n",
    "    # Recheck artifact availability even if the earlier restoration cell was skipped.\n",
    "    restore_run_artifacts(\n",
    "        output_dir,\n",
    "        source_hint=ARTIFACT_SOURCE_HINT,\n",
    "    )\n",
    "\n",
    "    required_paths = {\n",
    "        \"configuration\": config_path,\n",
    "        \"sample submission\": Path(SAMPLE_SUBMISSION_PATH),\n",
    "        \"checkpoint\": checkpoint_path,\n",
    "        \"post-processing parameters\": postprocessing_path,\n",
    "    }\n",
    "    missing = {\n",
    "        label: path for label, path in required_paths.items()\n",
    "        if not path.is_file()\n",
    "    }\n",
    "    if missing:\n",
    "        raise FileNotFoundError(\n",
    "            \"Submission prerequisites are missing: \"\n",
    "            + \", \".join(f\"{label}={path}\" for label, path in missing.items())\n",
    "        )\n",
    "    if not RLE_ORDER_CONFIRMED:\n",
    "        raise RuntimeError(\"RLE order has not been confirmed\")\n",
    "    if RLE_ORDER.upper() != \"C\":\n",
    "        raise RuntimeError(\n",
    "            \"This controlled submission is expected to use C-order, matching \"\n",
    "            \"the original notebook's np.ndarray.flatten() encoder.\"\n",
    "        )\n",
    "\n",
    "    command = [\n",
    "        sys.executable, \"-m\", \"skin_lesion_segmentation.cli\",\n",
    "        \"submit\", \"--config\", config_path,\n",
    "        \"--checkpoint\", checkpoint_path,\n",
    "        \"--postprocessing\", postprocessing_path,\n",
    "    ]\n",
    "    print(\"$\", \" \\".join(str(part) for part in command))\n",
    "    completed = subprocess.run(command, cwd=REPO_ROOT, text=True)\n",
    "    if completed.returncode != 0:\n",
    "        raise RuntimeError(f\"Submission command failed with exit code {completed.returncode}\")\n",
    "\n",
    "    if not submission_path.is_file() or not submission_summary_path.is_file():\n",
    "        raise RuntimeError(\"Submission command completed without producing both required outputs\")\n",
    "\n",
    "    submission = pd.read_csv(submission_path, keep_default_na=False)\n",
    "    summary = json.loads(submission_summary_path.read_text())\n",
    "\n",
    "    if not summary.get(\"sample_submission_validated\"):\n",
    "        raise RuntimeError(\"Submission was not validated against the official sample template\")\n",
    "    if summary.get(\"rle_order\") != \"C\":\n",
    "        raise RuntimeError(f\"Unexpected RLE order in summary: {summary.get('rle_order')}\")\n",
    "    if summary.get(\"submission_mask_height\") != 512 or summary.get(\"submission_mask_width\") != 512:\n",
    "        raise RuntimeError(\"Submission geometry is not the required fixed 512 x 512\")\n",
    "    if summary.get(\"maximum_valid_rle_position\") != 512 * 512:\n",
    "        raise RuntimeError(\"Submission RLE bounds do not match 512 x 512 geometry\")\n",
    "    if len(submission) != int(summary[\"rows\"]):\n",
    "        raise RuntimeError(\"Submission row count does not match validation summary\")\n",
    "    if submission.columns.tolist() != summary[\"columns\"]:\n",
    "        raise RuntimeError(\"Submission columns do not match validation summary\")\n",
    "    if submission.iloc[:, 0].duplicated().any():\n",
    "        raise RuntimeError(\"Submission contains duplicate IDs\")\n",
    "    if submission.iloc[:, 1].isna().any():\n",
    "        raise RuntimeError(\"Submission contains missing RLE values\")\n",
    "\n",
    "    print(json.dumps(summary, indent=2))\n",
    "    display(submission.head())\n",
    "    print(\"Submission ready:\", submission_path)\n",
    "else:\n",
    "    print(\"Submission skipped because WORKFLOW_MODE is not 'submit'.\")"
   ]

   ]
